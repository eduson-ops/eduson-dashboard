/**
 * Trial booking endpoint. Configure Script Properties:
 * SHEET_ID, BOOKINGS_SHEET_NAME=Записи на пробный, SLOTS_SHEET_NAME=Слоты,
 * DOC_ID, ROLE_MAP_JSON={"kc@example.com":{"role":"call_center"...}}
 */
const BOOKING_HEADERS = ['ID', 'Отметка времени', 'Дата', 'Время', 'Сейл', 'AmoCRM', 'Возраст', 'Телефон', 'Место', 'Статус', 'Автор', 'Изменено', 'Кто изменил', 'Idempotency-Key', 'Резервный журнал'];
function doGet(e) { try { const action = (e && e.parameter && e.parameter.action) || 'list'; const actor = actor_(); if (action === 'list') return json_({ ok: true, bookings: listBookings_(actor) }); if (action === 'slots') return json_({ ok: true, slots: readSlots_() }); return json_({ ok: false, error: 'Неизвестное действие' }); } catch (err) { return json_({ ok: false, error: String(err.message || err) }); } }
function doPost(e) { const lock = LockService.getScriptLock(); lock.waitLock(15000); try { const body = JSON.parse((e && e.postData && e.postData.contents) || '{}'); const actor = actor_(); if (body.action === 'create') return json_(create_(body, actor)); if (body.action === 'confirm' || body.action === 'reject') return json_(transition_(body, actor)); return json_({ ok: false, error: 'Неизвестное действие' }); } catch (err) { return json_({ ok: false, error: String(err.message || err), status: err.statusCode || 400 }); } finally { lock.releaseLock(); } }
function create_(body, actor) { if (actor.role !== 'call_center') throw Error('Создавать записи может только КЦ'); ['date', 'time', 'sale', 'crmUrl', 'age', 'phone', 'idempotencyKey'].forEach(function (key) { if (!String(body[key] || '').trim()) throw Error('Не заполнено поле: ' + key); }); if (!/^https:\/\/[^\s/]+\.amocrm\.ru\/\S+$/i.test(body.crmUrl)) throw Error('Некорректная ссылка AmoCRM'); const age = Number(body.age); if (!Number.isInteger(age) || age < 1 || age > 18) throw Error('Возраст должен быть от 1 до 18 лет'); const phone = String(body.phone).replace(/\D/g, ''); if (phone.length < 10 || phone.length > 15) throw Error('Некорректный телефон'); const sheet = bookingsSheet_(); const rows = sheet.getDataRange().getValues(); const existing = rows.slice(1).find(function (row) { return String(row[13]) === String(body.idempotencyKey); }); if (existing) return { ok: true, bookingId: existing[0], booking: rowToBooking_(existing) }; const capacity = readSlots_().filter(function (slot) { return slot.date === body.date && slot.time === body.time && slot.manager === body.sale && slot.status === 'wait'; }).length; const used = rows.slice(1).filter(function (row) { return row[2] === body.date && row[3] === body.time && row[4] === body.sale && ['pending_confirmation', 'confirmed'].indexOf(row[9]) >= 0; }).length; if (!capacity || used >= capacity) throw Error('Свободных мест в этом слоте больше нет'); const now = new Date(); const bookingId = 'booking-' + now.getTime() + '-' + Utilities.getUuid().slice(0, 8); const values = [bookingId, now, body.date, body.time, body.sale, body.crmUrl, age, phone, used + 1, 'pending_confirmation', actor.email, now, actor.email, body.idempotencyKey, 'pending']; ensureHeaders_(sheet); sheet.appendRow(values); const backup = appendDoc_(values); sheet.getRange(sheet.getLastRow(), 15).setValue(backup ? 'ok' : 'backup_pending'); return { ok: true, bookingId: bookingId, booking: rowToBooking_(values), backup: backup ? 'ok' : 'backup_pending' }; }
function transition_(body, actor) { if (actor.role !== 'confirmation_manager') throw Error('Подтверждать записи может только вторая линия'); const sheet = bookingsSheet_(); const values = sheet.getDataRange().getValues(); const index = values.findIndex(function (row, i) { return i > 0 && String(row[0]) === String(body.bookingId); }); if (index < 1) throw Error('Запись не найдена'); const from = String(values[index][9]); const to = body.action === 'confirm' ? 'confirmed' : 'rejected'; if (from !== 'pending_confirmation') throw Error('Статус уже изменён'); const now = new Date(); sheet.getRange(index + 1, 10, 1, 4).setValues([[to, values[index][10], now, actor.email]]); appendDoc_(values[index].map(function (v, i) { return i === 9 ? to : i === 11 ? now : i === 12 ? actor.email : v; })); return { ok: true, bookingId: body.bookingId, status: to }; }
function listBookings_(actor) { const rows = bookingsSheet_().getDataRange().getValues().slice(1).map(rowToBooking_); if (actor.role === 'confirmation_manager') return rows.filter(function (row) { return row.status === 'pending_confirmation'; }); if (actor.role === 'sales') return rows.filter(function (row) { return row.status === 'confirmed' && row.sale === actor.name; }); return rows.filter(function (row) { return row.createdBy === actor.email; }); }
function readSlots_() { const sheet = SpreadsheetApp.openById(prop_('SHEET_ID')).getSheetByName(prop_('SLOTS_SHEET_NAME') || 'Слоты'); return sheet.getDataRange().getValues().slice(1).map(function (row) { return { date: String(row[0]), time: String(row[1]), manager: String(row[2]), status: String(row[3]).toLowerCase() }; }); }
function rowToBooking_(row) { return { bookingId: row[0], createdAt: row[1], date: row[2], time: row[3], sale: row[4], crmUrl: row[5], age: row[6], phone: row[7], place: row[8], status: row[9], createdBy: row[10], updatedAt: row[11], updatedBy: row[12], idempotencyKey: row[13], backupStatus: row[14] }; }
function bookingsSheet_() { return SpreadsheetApp.openById(prop_('SHEET_ID')).getSheetByName(prop_('BOOKINGS_SHEET_NAME') || 'Записи на пробный'); }
function ensureHeaders_(sheet) { if (sheet.getLastRow() === 0) sheet.appendRow(BOOKING_HEADERS); }
function appendDoc_(values) { try { DocumentApp.openById(prop_('DOC_ID')).getBody().appendParagraph(values.map(String).join(' | ')); return true; } catch (err) { return false; } }
function actor_() { const email = Session.getActiveUser().getEmail(); const map = JSON.parse(prop_('ROLE_MAP_JSON') || '{}'); const entry = map[email] || {}; return { email: email, role: entry.role || '', name: entry.name || '' }; }
function prop_(key) { return PropertiesService.getScriptProperties().getProperty(key) || ''; }
function json_(value) { return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON); }
function edusonAuthorizeBooking() { return SpreadsheetApp.openById(prop_('SHEET_ID')).getName(); }

// JSONP and form fallbacks keep the static GitHub Pages client usable across origins.
function doGet(e) { try { const rawAction = (e && e.parameter && e.parameter.action) || 'list'; const marker = String(rawAction).match(/^(list|slots)\|callback:([A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*)$/); const action = marker ? marker[1] : rawAction; const callback = marker ? marker[2] : e && e.parameter && e.parameter.callback; const actor = actor_(); const value = action === 'list' ? { ok: true, bookings: listBookings_(actor) } : action === 'slots' ? { ok: true, slots: readSlots_() } : { ok: false, error: 'Неизвестное действие' }; return jsonp_(value, callback); } catch (err) { return jsonp_({ ok: false, error: String(err.message || err) }, e && e.parameter && e.parameter.callback); } }
function doPost(e) { const lock = LockService.getScriptLock(); lock.waitLock(15000); try { const raw = (e && e.postData && e.postData.contents) || ''; let body; try { body = JSON.parse(raw || '{}'); } catch (_) { body = (e && e.parameter) || {}; } const actor = actor_(); let result; if (body.action === 'create') result = create_(body, actor); else if (body.action === 'confirm' || body.action === 'reject') result = transition_(body, actor); else result = { ok: false, error: 'Неизвестное действие' }; return formResponse_(result, e); } catch (err) { return formResponse_({ ok: false, error: String(err.message || err), status: err.statusCode || 400 }, e); } finally { lock.releaseLock(); } }
function formResponse_(value, e) { const type = String(e && e.postData && e.postData.type || ''); if (type.indexOf('application/x-www-form-urlencoded') === 0) { const message = JSON.stringify({ source: 'eduson-booking', payload: value }).replace(/</g, '\\u003c'); return HtmlService.createHtmlOutput('<!doctype html><script>window.parent.postMessage(' + message + ', "*");</script>'); } return json_(value); }
function jsonp_(value, callback) { const payload = JSON.stringify(value); if (callback && /^[A-Za-z_$][\w$]*(\.[A-Za-z_$][\w$]*)*$/.test(callback)) return ContentService.createTextOutput(callback + '(' + payload + ');').setMimeType(ContentService.MimeType.JAVASCRIPT); return ContentService.createTextOutput(payload).setMimeType(ContentService.MimeType.JSON); }
