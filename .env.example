# Шаблон конфигурации. Значения в угловых скобках нужно заменить.
# Это не рабочие реквизиты. Не храните заполненный файл в репозитории.
# Production: /etc/eduson-booking-platform.env, root:booking, права 0640.
# Node не читает .env сам: используйте EnvironmentFile systemd или node --env-file.

HOST=127.0.0.1
PORT=4180

# По умолчанию лимит входа использует IP TCP-соединения, без доверия заголовкам.
# Включайте 1 только после проверки локального nginx с X-Forwarded-For
# $proxy_add_x_forwarded_for и недоступности backend извне (HOST=127.0.0.1).
# При 1 сервер принимает последний IP заголовка только от loopback peer.
# Невалидный IP или другой peer возвращают проверку к IP TCP-соединения.
BOOKING_TRUST_PROXY=0

# Укажите реальную БД после инвентаризации. Приложение использует схему eduson_booking.
# Пароль и другие специальные символы URL нужно percent-encode.
DATABASE_URL="postgresql://<db-user>:<url-encoded-password>@<db-host>:<db-port>/<owner-verified-database>"

# Локальная проверка через HTTP. Для production задайте действительный HTTPS origin
# и BOOKING_SECURE_COOKIES=1 только после установки и проверки TLS.
BOOKING_PUBLIC_ORIGIN=http://127.0.0.1:4180
BOOKING_SECURE_COOKIES=0

# Не включать embedded в production. Если DATABASE_URL задан, он имеет приоритет.
# Для отдельного локального просмотра: удалить DATABASE_URL и явно задать 1.
BOOKING_EMBEDDED=0
# BOOKING_DATA_DIR=/absolute/path/to/local-booking-data

# Необязательное создание первого активного администратора.
# При существующем активном администраторе эти параметры не меняют его пароль.
# Задайте уникальный пароль от 10 до 256 символов; не используйте пароль демо.
# После создания администратора удалите bootstrap-параметры из рабочего файла.
BOOKING_ADMIN_EMAIL=
BOOKING_ADMIN_PASSWORD=
BOOKING_ADMIN_NAME=Администратор

# Запись в Google по умолчанию выключена. Включать только после сверки копии таблицы.
BOOKING_SHEETS_SYNC=0
# Путь к JSON-файлу сервисного аккаунта вне репозитория и webroot.
# Не вставляйте содержимое JSON в этот файл, HTML или исходники.
GOOGLE_SERVICE_ACCOUNT_PATH=
BOOKING_SHEET_ID=
# Реестр зачисления учеников. Если не задан, используется согласованный реестр Eduson.
BOOKING_ENROLLMENT_SHEET_ID=12YC54i8r4tdo8PqH764RfUpGzdJF0xYyj3GJ-7NBrNw
# Названия отдельных листов нового календаря. Пустые значения используют прежние названия.
BOOKING_SCHEDULE_SHEET_NAME=
BOOKING_SLOTS_SHEET_NAME=
# Защищённый JSON Slack вне репозитория; токен и точные соответствия сотрудников хранятся только там.
BOOKING_SLACK_CONFIG_PATH=
# Отдельный bearer и разрешённые аккаунты Rubitime; JSON вне репозитория и webroot.
BOOKING_RUBITIME_CONFIG_PATH=
