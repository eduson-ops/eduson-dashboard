# Неактивный фрагмент для server{} отдельного, согласованного virtual host.
# Не копируйте поверх действующего vhost и не добавляйте в общий default_server.
# Сначала инвентаризируйте домен, порты, текущие маршруты и сертификаты.
# Все пути нового приложения должны использовать один origin.
# Для данного фрагмента upstream должен слушать только 127.0.0.1:4180.
# X-Forwarded-For должен дополняться через $proxy_add_x_forwarded_for:
# последний элемент содержит IP клиента этого nginx. После проверки задайте
# BOOKING_TRUST_PROXY=1. По умолчанию 0 использует общий loopback IP nginx.
# Сервер не доверяет заголовку от внешнего peer или при невалидном последнем IP.
# Не добавляйте listen 443, HTTPS-редирект и пути ssl_certificate до установки TLS.
# После установки TLS укажите реальные пути сертификатов в согласованном vhost,
# проверьте HTTPS, затем задайте HTTPS BOOKING_PUBLIC_ORIGIN и secure cookies.

client_max_body_size 64k;

# SSE: сервер отправляет heartbeat каждые 20 секунд.
location = /api/events {
    proxy_pass http://127.0.0.1:4180;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 75s;
    send_timeout 75s;
}

# Корень, /booking/, /dashboard/, API и разрешённые сервером assets.
location / {
    proxy_pass http://127.0.0.1:4180;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
}
